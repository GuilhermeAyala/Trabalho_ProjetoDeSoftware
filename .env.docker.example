# Copie para .env.docker antes de alterar valores locais do Docker.
# Senhas com caracteres especiais precisam estar codificadas para URL,
# pois também fazem parte da DATABASE_URL criada pelo docker-compose.
POSTGRES_USER=vitta
POSTGRES_PASSWORD=vitta_dev
POSTGRES_DB=vitta

# A porta 5433 evita conflito com PostgreSQL local na porta 5432.
POSTGRES_PORT=5433
REDIS_PORT=6380
API_PORT=3000
FRONTEND_PORT=8081

# Tempo de vida, em segundos, das consultas guardadas no Redis.
REDIS_CACHE_TTL_SECONDS=60

# Valor usado no bundle web. Para abrir pelo navegador desta máquina, mantenha localhost.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Chave usada para criptografar CPF com AES-256-GCM. Use 32 caracteres ou mais.
CPF_ENCRYPTION_KEY=troque_esta_chave_de_criptografia_cpf_2026

# Senha inicial do administrador criada pelo seed (e-mail: admin@vitta.local).
ADMIN_SEED_PASSWORD=VittaAdmin@2026
