# Web/iOS Simulator no mesmo computador:
EXPO_PUBLIC_API_URL=http://localhost:3000

# Id temporário usado pelo protótipo enquanto o fluxo de login não está ativo.
# O doador de id 1 precisa existir no banco local.
EXPO_PUBLIC_DOADOR_ID=1

# Em um celular físico, troque localhost pelo IP do computador na rede local.
# Exemplo: EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
