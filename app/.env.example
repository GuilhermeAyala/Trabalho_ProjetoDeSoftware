# A URL é detectada automaticamente a partir do computador que executa o Expo.
# Para usar outra API, remova o # e informe a URL completa:
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000

# Id temporário usado pelo protótipo enquanto o fluxo de login não está ativo.
# O doador de id 1 precisa existir no banco local.
EXPO_PUBLIC_DOADOR_ID=1

# O celular e o computador precisam estar na mesma rede local.
